# ---------------------------------------------------------------------------
# Docs Health backend configuration. Copy to .env and adjust.
# ---------------------------------------------------------------------------
ENVIRONMENT=dev

# PostgreSQL (primary store). Create the role/database with scripts/bootstrap_db.py.
# The API runs as a least-privilege role (create it with: python -m scripts.create_app_role)
DATABASE_URL=postgresql+psycopg://docshealth_app:CHANGE_ME@localhost:5432/scribe_docs
# Owner/admin connection used only for schema changes (check_db --create, startup upgrades)
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/scribe_docs
# Offline fallback for demos/tests without Postgres:
# DATABASE_URL=sqlite:///./data/docshealth.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo staff accounts created by `python -m scripts.init_db --seed`
SEED_ADMIN_EMAIL=admin@docshealth.local
SEED_ADMIN_PASSWORD=DemoAdmin!2026
SEED_SCHEDULER_EMAIL=scheduler@docshealth.local
SEED_SCHEDULER_PASSWORD=DemoSched!2026

# ---------------------------------------------------------------------------
# LLM provider: mock | openai | azure_openai | gemini | huggingface
#   mock = deterministic rule-based engine, no network, no PHI leaves the host.
# Only send PHI to a provider covered by a BAA (e.g. Azure OpenAI).
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# ---------------------------------------------------------------------------
# Automation policy
# ---------------------------------------------------------------------------
AI_CONFIDENCE_THRESHOLD=0.80
MATCH_CONFIDENCE_THRESHOLD=0.80
AUTO_BOOK_APPOINTMENTS=true
AUTO_SEND_RESPONSES=true
CLINIC_NAME=Docs Health
CLINIC_TIMEZONE=America/Chicago

# ---------------------------------------------------------------------------
# Email (Outlook) integration
#   inbound:  none | graph | imap      outbound: outbox | smtp | graph
#   outbox = replies are stored and shown in the portal, never sent (safe for demos).
# ---------------------------------------------------------------------------
EMAIL_INBOUND_MODE=none
EMAIL_OUTBOUND_MODE=outbox
SCHEDULING_MAILBOX=scheduling@docshealth.example
MAIL_POLL_INTERVAL_SECONDS=0

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=scheduling@docshealth.example
SMTP_FROM_NAME=Docs Health Scheduling
# starttls (587, Microsoft 365 / Gmail) | ssl (465) | none (localhost test servers only)
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=20
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_BASE_SECONDS=2

# Eligibility clearinghouse adapter: mock (deterministic demo payer rules)
ELIGIBILITY_ADAPTER=mock
UPLOAD_DIR=./data/uploads
# Outbox mode also saves every outgoing email as an .eml file in this folder
# (open it to use a password-reset link when no real mailbox is configured).
# MAIL_DROP_DIR=./data/maildrop

# ---------------------------------------------------------------------------
# Password reset (identity verification by email)
# ---------------------------------------------------------------------------
PORTAL_BASE_URL=http://localhost:5181
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_WINDOW=3

# ---------------------------------------------------------------------------
# Sensitive data & practice identity
# ---------------------------------------------------------------------------
# Encrypts SSN / driver's license at rest. Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
PRACTICE_NAME=Docs Health Medical Group
PRACTICE_GROUP_NPI=1912345678
HUGGINGFACE_API_KEY="your_huggingface_token_here"